<main class="container">
  {{#if product}}
    <article class="product-detail">
      <div class="product-detail-grid">
        <div class="product-detail-media">
          {{#if product.thumbnails.[0]}}
            <img src="{{product.thumbnails.[0]}}" alt="{{product.title}}" class="product-detail-img" />
          {{else}}
            <div class="card-placeholder product-detail-placeholder">Sin imagen</div>
          {{/if}}
        </div>
        <div class="product-detail-info">
          <h1>{{product.title}}</h1>
          <p class="product-detail-description">{{product.description}}</p>
          <dl class="product-detail-meta">
            <dt>Código</dt>
            <dd>{{product.code}}</dd>
            <dt>Categoría</dt>
            <dd>{{product.category}}</dd>
            <dt>Stock</dt>
            <dd>{{product.stock}} unidades</dd>
            <dt>Disponibilidad</dt>
            <dd>{{#if product.status}}Disponible{{else}}No disponible{{/if}}</dd>
          </dl>
          <p class="product-detail-price">$ {{product.price}}</p>
          {{#if product.status}}
            <button class="btn btn-add-cart" data-product-id="{{product.id}}">Agregar al carrito</button>
          {{else}}
            <button class="btn btn-add-cart" disabled>No disponible</button>
          {{/if}}
          <a href="/productos" class="btn btn-secondary">Volver al catálogo</a>
        </div>
      </div>
    </article>
  {{else}}
    <section class="section-title">
      <h2>Producto no encontrado</h2>
      <a href="/productos" class="btn">Volver al catálogo</a>
    </section>
  {{/if}}
</main>

<script src="/js/app.js"></script>
<script>
  document.querySelector(".btn-add-cart")?.addEventListener("click", async function () {
    const productId = this.dataset.productId;
    if (!productId) return;
    const API_BASE = "/api";
    let cartId = localStorage.getItem("cartId");
    if (!cartId) {
      const r = await fetch(API_BASE + "/carts", { method: "POST" });
      const d = await r.json();
      cartId = d.payload._id || d.payload.id;
      localStorage.setItem("cartId", cartId);
    }
    await fetch(API_BASE + "/carts/" + cartId + "/product/" + productId, { method: "POST" });
    this.textContent = "Agregado";
    this.disabled = true;
  });
</script>
